<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console harness that runs the Unity plate-solving and mount sources without Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\AstroTracker\Assets\Scripts\PlateSolving\**\*.cs" LinkBase="PlateSolving" />
    <Compile Include="..\..\AstroTracker\Assets\Scripts\Mount\**\*.cs" LinkBase="Mount" />
  </ItemGroup>

</Project>
