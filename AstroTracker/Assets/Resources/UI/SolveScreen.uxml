<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="SolveScreen.uss" />
    <ui:ScrollView class="screen" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
        <ui:VisualElement class="content">
            <ui:VisualElement class="header">
                <ui:Label text="AstroTracker" class="title" />
                <ui:VisualElement class="languages">
                    <ui:Button name="language-en" text="EN" class="language" />
                    <ui:Button name="language-ru" text="РУС" class="language" />
                    <ui:Button name="language-uk" text="УКР" class="language" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="row">
                <ui:Button name="pick" text="Choose photo" class="button" />
                <ui:Label name="file" text="No photo selected" class="file" />
            </ui:VisualElement>
            <ui:TextField name="search" label="Object" placeholder-text="M 82, NGC 7000, Orion" class="field" />
            <ui:VisualElement name="matches" class="matches" />
            <ui:TextField name="ra" label="Target RA, hours" value="9 55 52" class="field" />
            <ui:TextField name="dec" label="Target Dec, degrees" value="+69 40 47" class="field" />
            <ui:TextField name="radius" label="Search radius, degrees" value="10" class="field" />
            <ui:TextField name="scale" label="Pixel scale, ″/pixel" value="1.37" class="field" />
            <ui:Button name="solve" text="Solve" class="button primary" />
            <ui:Label name="result" class="result" />
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
