.screen {
    flex-grow: 1;
    background-color: rgb(16, 18, 24);
}

.content {
    width: 100%;
    max-width: 760px;
    align-self: center;
    padding: 24px;
}

.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.languages {
    flex-direction: row;
}

.language {
    height: 40px;
    min-width: 64px;
    margin: 0 0 0 6px;
    padding: 0 10px;
    font-size: 16px;
    color: rgb(170, 176, 190);
    background-color: rgb(28, 31, 40);
    border-width: 0;
    border-radius: 6px;
}

.language:hover {
    background-color: rgb(40, 45, 58);
}

.language-active {
    color: rgb(255, 255, 255);
    background-color: rgb(40, 110, 220);
}

.language-active:hover {
    background-color: rgb(40, 110, 220);
}

.row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.button {
    height: 56px;
    margin: 0;
    padding: 0 24px;
    font-size: 22px;
    color: rgb(255, 255, 255);
    background-color: rgb(52, 58, 72);
    border-width: 0;
    border-radius: 8px;
}

.button:hover {
    background-color: rgb(64, 71, 88);
}

.button:active {
    background-color: rgb(40, 45, 56);
}

.button:disabled {
    opacity: 0.45;
}

.primary {
    margin-top: 12px;
    background-color: rgb(40, 110, 220);
}

.primary:hover {
    background-color: rgb(58, 126, 234);
}

.primary:active {
    background-color: rgb(30, 90, 190);
}

.file {
    flex-shrink: 1;
    margin-left: 16px;
    font-size: 18px;
    color: rgb(170, 176, 190);
    overflow: hidden;
    text-overflow: ellipsis;
}

.field {
    margin: 0 0 10px 0;
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.field > .unity-base-field__label {
    min-width: 300px;
    align-self: center;
    color: rgb(200, 205, 215);
}

.field .unity-base-text-field__input {
    height: 48px;
    padding: 0 12px;
    background-color: rgb(28, 31, 40);
    border-color: rgb(70, 76, 92);
    border-radius: 6px;
}

.matches {
    margin-bottom: 6px;
}

.match {
    height: 44px;
    margin: 0 0 4px 0;
    padding: 0 12px;
    font-size: 18px;
    -unity-text-align: middle-left;
    color: rgb(230, 233, 240);
    background-color: rgb(28, 31, 40);
    border-width: 0;
    border-radius: 6px;
}

.match:hover {
    background-color: rgb(40, 45, 58);
}

.match:active {
    background-color: rgb(52, 58, 72);
}

.section {
    margin: 28px 0 12px 0;
    padding-top: 20px;
    border-top-width: 1px;
    border-top-color: rgb(52, 58, 72);
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.mount-button {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
    padding: 0 8px;
}

.stop {
    margin-right: 0;
    background-color: rgb(190, 50, 50);
}

.stop:hover {
    background-color: rgb(210, 64, 64);
}

.stop:active {
    background-color: rgb(160, 40, 40);
}

.mount-status {
    margin-top: 0;
    margin-bottom: 24px;
}

.result {
    margin-top: 20px;
    font-size: 20px;
    color: rgb(230, 233, 240);
    white-space: normal;
}
