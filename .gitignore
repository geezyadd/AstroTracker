# The Unity project lives in /AstroTracker, so root-anchored rules are prefixed with it
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/AstroTracker/[Ll]ibrary/
/AstroTracker/[Tt]emp/
/AstroTracker/[Oo]bj/
/AstroTracker/[Bb]uild/
/AstroTracker/[Bb]uilds/
/AstroTracker/[Ll]ogs/
/AstroTracker/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/AstroTracker/[Mm]emoryCaptures/

# Recordings can get excessive in size
/AstroTracker/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/AstroTracker/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/AstroTracker/ServerData
/AstroTracker/[Aa]ssets/StreamingAssets/aa*
/AstroTracker/[Aa]ssets/AddressableAssetsData/link.xml*
/AstroTracker/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/AstroTracker/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/AstroTracker/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/AstroTracker/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/AstroTracker/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/AstroTracker/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/AstroTracker/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit auto generated files
/AstroTracker/UIElementsSchema/

# Auto-generated cache in Assets folder
/AstroTracker/[Aa]ssets/[Ss]ceneDependencyCache*

# Star catalogue: downloaded sources
/Tools/StarCatalog/raw/

# .NET build output of the tools
/Tools/**/bin/
/Tools/**/obj/
!/Tools/**/*.csproj
